# Path to the Akamai EdgeGrid credentials file. Defaults to ~/.edgerc.
EDGERC_PATH=~/.edgerc

# Section inside .edgerc to use. Defaults to "default".
AKAMAI_EDGERC_SECTION=default

# Logging verbosity for the MCP server (DEBUG, INFO, WARNING, ERROR).
# Logs are written to stderr; stdout is reserved for the MCP transport.
LOG_LEVEL=INFO

# Optional Akamai account switch key for delegated access (partners / managed
# service providers). Format: B-XXXXXX:1-XXXXX. Overrides any account_key /
# account-switch-key set in your .edgerc section.
# AKAMAI_ACCOUNT_SWITCH_KEY=B-X-XXXXXXX:1-XXXXX
